{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "WRANGLER_WRITE_LOGS": "false"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.dev.vars)",
      "Edit(./.env)",
      "Edit(./.dev.vars)",
      "Write(./.env)",
      "Write(./.dev.vars)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [".env", ".dev.vars"],
      "denyWrite": [".env", ".dev.vars"]
    }
  }
}
