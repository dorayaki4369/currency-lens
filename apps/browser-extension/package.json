{
  "name": "@cl/browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Currency Lens Browser Extension",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env scripts/run-wxt-without-env.mjs",
    "dev:firefox": "node --env-file-if-exists=../../.env scripts/run-wxt-without-env.mjs -b firefox --mv3",
    "build": "node scripts/run-wxt-without-env.mjs build",
    "build:firefox": "node scripts/run-wxt-without-env.mjs build -b firefox --mv3",
    "zip": "node scripts/run-wxt-without-env.mjs zip",
    "zip:firefox": "node scripts/run-wxt-without-env.mjs zip -b firefox --mv3",
    "postinstall": "pnpm run routes:generate",
    "routes:generate": "node scripts/run-wxt-without-env.mjs prepare",
    "wxt": "node scripts/run-wxt-without-env.mjs"
  },
  "dependencies": {
    "@cl/currency": "workspace:*",
    "@floating-ui/react-dom": "^2.1.9",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cryptocurrency-icons": "^0.18.1",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "publish-browser-extension": "^6.2.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "wxt": "^0.20.27"
  }
}
