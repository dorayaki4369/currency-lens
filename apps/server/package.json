{
  "name": "@cl/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/wrangler/bin/wrangler.js dev --env-file /dev/null --test-scheduled",
    "typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-file /dev/null --env-interface CloudflareBindings",
    "build": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler build --env-file /dev/null",
    "deploy": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler deploy --env-file /dev/null --minify"
  },
  "dependencies": {
    "@cl/oxr": "workspace:*",
    "hono": "^4.12.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "wrangler": "^4.111.0"
  }
}
