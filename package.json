{
  "name": "currency-lens",
  "version": "0.1.0",
  "private": true,
  "description": "A browser extension for converting selected prices into configured target currencies.",
  "license": "MIT",
  "author": {
    "name": "Ryuya Hirayama",
    "email": "ryuya.hirayama@dryk.net"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vp run --no-cache -r --parallel dev",
    "build": "vp run -r build",
    "check": "vp check",
    "test": "pnpm test:unit",
    "test:unit": "vp test --run --project unit",
    "test:integration": "vp test --run --project integration",
    "test:coverage": "vp test --run --coverage --project unit",
    "test:e2e": "pnpm -C apps/browser-extension build && playwright test",
    "validate": "vp check && pnpm test:coverage && pnpm test:integration && vp run -r build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.14.0",
    "happy-dom": "^20.10.6",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": "npm not allowed",
    "pnpm": ">=11.13.0",
    "yarn": "yarn not allowed"
  },
  "packageManager": "pnpm@11.24.0"
}
